{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "allowImportingTsExtensions": true,
    "types": ["deno", "node"]
  },
  "include": ["*.ts"]
}
