# Optional for local demo; required for shared live reports.
# Get these from Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Required for Google Maps in standalone Android builds, not Expo Go.
# Restrict this key to your Android package/signing certificate and Maps SDK.
GOOGLE_MAPS_ANDROID_API_KEY=

# NEVER put OPENAI_API_KEY or a Supabase service-role key here.
# Set AI secrets on the Supabase Edge Function server instead (docs/BACKEND.md).
