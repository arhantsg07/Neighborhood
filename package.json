{
  "name": "neighborhood-issue-reporter",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --project supabase/functions/analyze-report/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:backend": "node --import tsx --test supabase/functions/analyze-report/handler_test.ts",
    "test:web": "expo export --platform web && node tests/web-smoke.mjs",
    "test:sql": "node supabase/tests/validate-sql.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.19",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
